# Local, rule-based SQL generation is the default and requires no API key.
# Set to "api" only when using an OpenAI-compatible SQL-generation provider.
INSIGHTSQL_LLM_MODE=offline
INSIGHTSQL_LLM_BASE_URL=https://api.openai.com/v1
# INSIGHTSQL_LLM_API_KEY=
INSIGHTSQL_LLM_MODEL=gpt-4o-mini

# Defaults are relative to the repository root.
INSIGHTSQL_DATABASE_PATH=employee_management.db
INSIGHTSQL_HISTORY_PATH=data/query_history.db
INSIGHTSQL_LOG_PATH=logs/insightsql.log

# Resource limits.
INSIGHTSQL_LLM_TIMEOUT_SECONDS=30
INSIGHTSQL_QUERY_TIMEOUT_SECONDS=3
INSIGHTSQL_MAX_RESULT_ROWS=500
INSIGHTSQL_HISTORY_LIMIT=500
